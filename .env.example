# Environment & Port Configuration
NODE_ENV=development
PORT=5000
BUILD_TARGET=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/linkstash

# JWT & Security (Legacy & Fallback)
JWT_SECRET=your-jwt-secret-key-change-in-production

# Supabase Configuration (Auth & Storage)
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_STORAGE_BUCKET=images

# [DEPRECATED] InsForge Storage (Migrated to Supabase)
# INSFORGE_URL=https://your-insforge-app.insforge.app/
# INSFORGE_ANON_KEY=your-insforge-anon-key
INSFORGE_STORAGE_BUCKET=images
INSFORGE_STORAGE_FOLDER=linkstash

# Scraper Settings
USER_AGENT=LinkStash-Bot/1.0
SCRAPER_ALLOWED_PORTS=80,443
SCRAPER_TIMEOUT_MS=10000
SCRAPER_MAX_CONTENT_LENGTH=2097152
SCRAPER_ALLOW_PUBLIC=true
SCRAPER_STORE_EXTERNAL_IMAGES=false
SCRAPER_QUEUE_CONCURRENCY=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# CORS Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# Logging
LOG_LEVEL=info

# Default Images
DEFAULT_IMAGE_URL=
DEFAULT_IMAGE_URLS=/defaults/default-image.png,/defaults/default-imagev2.png
DEFAULT_IMAGE_STRATEGY=random
DEFAULT_DESCRIPTION=Sin descripción
ASK_FOR_DESCRIPTION=false

# Server URLs
BACKEND_BASE_URL=http://localhost:5000
TRUST_PROXY=true

# Redis / BullMQ
ENABLE_BULLMQ=true
REDIS_PASSWORD=LinkStashSecurePass123!
REDIS_PORT_EXTERNAL=6379

# Scraper Worker
ENABLE_SCRAPER_WORKER=true

# Admin Users
ADMIN_EMAILS=admin@example.com
ADMIN_USER_IDS=
