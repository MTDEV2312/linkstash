# ========== SERVER CONFIGURATION ==========
NODE_ENV=development
PORT=5000
TRUST_PROXY=false
SCRAPER_STORE_EXTERNAL_IMAGES=false

# ========== DATABASE ==========
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/linkstash?retryWrites=true&w=majority

# ========== SUPABASE (AUTH & STORAGE) ==========
SUPABASE_URL=https://supabase.mathiast.me
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://supabase.mathiast.me/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=images

# ========== RATE LIMITING & CORS ==========
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
ALLOWED_ORIGINS=https://mylinks.mathiast.me,http://localhost:4173,http://localhost:3000

# ========== LOGGING ==========
LOG_LEVEL=info

# ========== SCRAPER WORKER & QUEUE ==========
ENABLE_SCRAPER_WORKER=true
SCRAPER_QUEUE_CONCURRENCY=3
REDIS_URL=redis://localhost:6379

# ========== DEFAULTS ==========
DEFAULT_IMAGE_URL=
DEFAULT_IMAGE_STRATEGY=random
DEFAULT_DESCRIPTION=Sin descripción
ASK_FOR_DESCRIPTION=false
ADMIN_EMAILS=
ADMIN_USER_IDS=