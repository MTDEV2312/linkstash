
# ========== SERVER CONFIGURATION ==========
# Ambiente: development, production
NODE_ENV=development

# Puerto
PORT=5000

# Confiar en proxy (para Render, Vercel, etc)
TRUST_PROXY=false

# ========== DATABASE ==========
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/linkstash

# ========== AUTHENTICATION ==========
# JWT Secret - Mínimo 32 caracteres
# Generar: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-secure-random-string

# ========== RATE LIMITING ==========
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ========== CORS ==========
# URLs permitidas separadas por comas
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ========== LOGGING ==========
# Niveles: error, warn, info, debug
LOG_LEVEL=info

# ========== SCRAPER WORKER ==========
ENABLE_SCRAPER_WORKER=true

# ========== REDIS (Optional para BullMQ) ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== SCRAPER CONFIGURATION ==========


DEFAULT_IMAGE_URL=
# Estrategia para imágenes por defecto: random | roundrobin
DEFAULT_IMAGE_STRATEGY=random

DEFAULT_DESCRIPTION=Sin descripción
# Si se quiere que el usuario complete la descripción, activar true.
ASK_FOR_DESCRIPTION=false

BACKEND_BASE_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CLOUDINARY_FOLDER=linkstash

SCRAPER_QUEUE_CONCURRENCY=3

TRUST_PROXY=false

# Redis (opcional, para BullMQ queue distribuida)
# Cuando se usa Docker Compose, usar REDIS_HOST=redis
# Para desarrollo local sin Docker, dejar vacío o usar localhost
REDIS_HOST=
REDIS_PORT=
REDIS_PORT_EXTERNAL=
ENABLE_BULLMQ=

# Worker de scraping (habilitar/deshabilitar)
ENABLE_SCRAPER_WORKER=