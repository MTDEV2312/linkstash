{
  "name": "linkstash-backend",
  "version": "1.0.0",
  "description": "LinkStash - Organizador de enlaces personal",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:unit": "node test/scraper_unit_tests.mjs && node test/scraper_redirect_tests.mjs",
    "test:tags": "node test/tags_existing_only_integration.mjs",
    "lint": "eslint . --ignore-path .gitignore",
    "inspect": "node --inspect app.js"
  },
  "keywords": [
    "links",
    "bookmarks",
    "organizer",
    "fullstack"
  ],
  "author": "Mathías Terán",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "axios": "1.18.0",
    "bullmq": "5.66.1",
    "cheerio": "1.0.0-rc.12",
    "compression": "^1.7.4",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.22.1",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.1.0",
    "ioredis": "5.8.2",
    "ipaddr.js": "2.2.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "7.8.7",
    "multer": "2.1.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "3.0.1"
  },
  "overrides": {
    "axios": "1.18.0",
    "express": "4.22.1",
    "mongoose": "7.8.7",
    "body-parser": "1.20.4",
    "cookie": "0.7.0",
    "path-to-regexp": "0.1.13",
    "send": "0.19.0",
    "qs": "6.14.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "publishConfig": {
    "access": "restricted",
    "provenance": true
  }
}
